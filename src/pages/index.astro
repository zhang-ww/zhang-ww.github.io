---
import ResearchContent from '../components/ResearchContent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout heading="Whitney Zhang" current="home" hasThumbnail>
  <div class="home-grid">
    <aside class="home-profile" aria-labelledby="profile-heading">
      <h1 id="profile-heading">Hi, I’m Whitney</h1>
      <img
        class="home-headshot"
        src="/images/whitney-zhang.jpeg"
        alt="Whitney Zhang"
        width="843"
        height="1024"
      />
      <p class="home-bio">I am a PhD candidate at <a href="https://economics.mit.edu/people/phd-students/whitney-zhang">MIT Economics</a> interested in how technologies, organizational decisions, and markets interact to shape work.</p>
      <p class="job-market"><strong>I am on the AY2026–27 job market.</strong></p>
      <div class="profile-actions">
        <a class="contact-button" href="https://economics.mit.edu/sites/default/files/2026-10/Zhang_CV_0.pdf">CV</a>
        <a class="contact-button" href="mailto:zhangww@mit.edu">Contact Me</a>
        <a class="contact-button icon-button" href="https://x.com/whitneywzhang" aria-label="Whitney Zhang on X">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
        </a>
        <a class="contact-button icon-button" href="https://scholar.google.com/citations?user=Xq-3vW8AAAAJ&amp;hl=en" aria-label="Whitney Zhang on Google Scholar">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 24a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm0-24L0 9.5l4.84 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.16 4.44L24 9.5Z" /></svg>
        </a>
      </div>
    </aside>

    <section class="home-research" aria-label="Research">
      <ResearchContent />
    </section>
  </div>
</BaseLayout>
