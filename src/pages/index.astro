---
import ResearchContent from '../components/ResearchContent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout heading="Whitney Zhang" current="home" hasThumbnail>
  <div class="home-grid">
    <aside class="home-profile" aria-labelledby="profile-heading">
      <img
        class="home-headshot"
        src="/images/whitney-zhang.jpeg"
        alt="Whitney Zhang"
        width="843"
        height="1024"
      />
      <h1 id="profile-heading">Hi, I’m Whitney</h1>
      <p>I am a PhD candidate at <a href="https://economics.mit.edu/">MIT Economics</a> interested in how <a href="https://news.mit.edu/2025/improving-workplace-future-whitney-zhang-0924">technologies and organizational decisions shape labor markets</a>. I am generously funded through the <a href="https://www.nsfgrfp.org">National Science Foundation Graduate Research Fellowship Program</a>. <strong>I am on the AY2026–27 job market.</strong></p>
      <p class="home-contact"><a href="mailto:zhangww@mit.edu">zhangww@mit.edu</a></p>
    </aside>

    <section class="home-research" aria-labelledby="research-heading">
      <h2 id="research-heading">Research</h2>
      <ResearchContent />
    </section>
  </div>
</BaseLayout>
