---
import ResearchContent from '../components/ResearchContent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout heading="Whitney Zhang" current="home" hasThumbnail>
  <div class="home-grid">
    <aside class="home-profile" aria-labelledby="profile-heading">
      <h1 id="profile-heading">Hi, I’m Whitney</h1>
      <img
        class="home-headshot"
        src="/images/whitney-zhang.jpeg"
        alt="Whitney Zhang"
        width="843"
        height="1024"
      />
      <p>I am a PhD candidate at <a href="https://economics.mit.edu/people/phd-students/whitney-zhang">MIT Economics</a> interested in how technologies, organizational decisions, and markets interact to shape work. I am generously funded through the National Science Foundation Graduate Research Fellowship Program.</p>
      <p class="job-market"><strong>I am on the AY2026–27 job market.</strong></p>
      <div class="profile-actions">
        <a class="contact-button" href="https://economics.mit.edu/sites/default/files/2026-10/Zhang_CV_0.pdf">CV</a>
        <a class="contact-button" href="mailto:zhangww@mit.edu">Contact Me</a>
      </div>
    </aside>

    <section class="home-research" aria-label="Research">
      <ResearchContent />
    </section>
  </div>
</BaseLayout>
