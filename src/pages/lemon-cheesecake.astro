---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="Lemon Cheesecake" heading="Lemon Cheesecake" current="other" description="Whitney Zhang's lemon cheesecake recipe.">
  <div id="recipe"></div>
  <div id="wprm-recipe-container-160" class="wprm-recipe-container" data-recipe-id="160" data-servings="0">
    <div class="wprm-recipe wprm-recipe-template-compact">
      <div class="wprm-container-float-right"><div class="wprm-spacer" style="height:5px"></div><a href="#" onclick="window.print(); return false;" style="color:#444;background-color:#fff;border-color:#777;border-radius:0;padding:5px" class="wprm-recipe-print wprm-recipe-link wprm-block-text-normal"><span class="wprm-recipe-icon"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="#444" d="M19 5.09V1c0-.552-.448-1-1-1H6c-.552 0-1 .448-1 1v4.09C2.167 5.569 0 8.033 0 11v7c0 .552.448 1 1 1h4v4c0 .552.448 1 1 1h12c.552 0 1-.448 1-1v-4h4c.552 0 1-.448 1-1v-7c0-2.967-2.167-5.431-5-5.91ZM7 2h10v3H7V2Zm10 20H7v-9h10v9Zm1-12a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z" /></svg></span> Print Recipe</a></div>
      <h2 class="wprm-recipe-name wprm-block-text-bold">Lemon Cheesecake</h2>
      <div class="wprm-spacer" style="height:5px"></div>
      <div class="wprm-recipe-summary wprm-block-text-normal"><span style="display:block">Based on <a href="https://www.eaglebrand.com/recipe-detail/lemoncheesecakewithfreshfruit-4532">https://www.eaglebrand.com/recipe-detail/lemoncheesecakewithfreshfruit-4532</a></span></div>
      <div class="wprm-spacer"></div>
      <div class="wprm-recipe-meta-container wprm-recipe-times-container wprm-recipe-details-container wprm-recipe-details-container-table wprm-block-text-normal" style="border-width:1px;border-style:solid;border-color:#777"><div class="wprm-recipe-block-container wprm-recipe-block-container-table wprm-recipe-time-container" style="border-width:1px;border-style:solid;border-color:#777"><span class="wprm-recipe-details-label wprm-block-text-faded">Prep Time</span><span class="wprm-recipe-time"><span class="wprm-recipe-details">20</span> <span class="wprm-recipe-details-unit">mins</span></span></div><div class="wprm-recipe-block-container wprm-recipe-block-container-table wprm-recipe-time-container" style="border-width:1px;border-style:solid;border-color:#777"><span class="wprm-recipe-details-label wprm-block-text-faded">Cook Time</span><span class="wprm-recipe-time"><span class="wprm-recipe-details">50</span> <span class="wprm-recipe-details-unit">mins</span></span></div></div>

      <div class="wprm-recipe-ingredients-container wprm-block-text-normal">
        <h3 class="wprm-recipe-header wprm-recipe-ingredients-header wprm-block-text-bold">Ingredients</h3>
        <div class="wprm-recipe-ingredient-group"><h4 class="wprm-recipe-group-name wprm-recipe-ingredient-group-name wprm-block-text-bold">Crust</h4><ul class="wprm-recipe-ingredients"><li style="list-style-type:disc">1¼ cup almond flour</li><li style="list-style-type:disc">4 tbsp butter</li><li style="list-style-type:disc">1 pinch of salt</li><li style="list-style-type:disc">1 pinch of cinnamon</li><li style="list-style-type:disc">1 pinch of sugar</li></ul></div>
        <div class="wprm-recipe-ingredient-group"><h4 class="wprm-recipe-group-name wprm-recipe-ingredient-group-name wprm-block-text-bold">Cake</h4><ul class="wprm-recipe-ingredients"><li style="list-style-type:disc">¼ cup sugar</li><li style="list-style-type:disc">¼ cup butter</li><li style="list-style-type:disc">16 oz cream cheese <span class="wprm-recipe-ingredient-notes wprm-recipe-ingredient-notes-faded">softened</span></li><li style="list-style-type:disc">14 oz sweetened condensed milk</li><li style="list-style-type:disc">3 large eggs</li><li style="list-style-type:disc">¼-⅓ cup lemon juice</li><li style="list-style-type:disc">1 tsp vanilla extract</li></ul></div>
      </div>
      <div class="wprm-recipe-instructions-container wprm-block-text-normal">
        <h3 class="wprm-recipe-header wprm-recipe-instructions-header wprm-block-text-bold">Instructions</h3>
        <div class="wprm-recipe-instruction-group"><h4 class="wprm-recipe-group-name wprm-recipe-instruction-group-name wprm-block-text-bold">Crust</h4><ul class="wprm-recipe-instructions"><li class="wprm-recipe-instruction" style="list-style-type:decimal"><div class="wprm-recipe-instruction-text">Toast almond flour in dry pan until golden brown.</div></li><li class="wprm-recipe-instruction" style="list-style-type:decimal"><div class="wprm-recipe-instruction-text">Melt the butter. </div></li><li class="wprm-recipe-instruction" style="list-style-type:decimal"><div class="wprm-recipe-instruction-text">Pour toasted almond flour into 9 inch springform pan and mix in melted butter over almond flour. Once combined, press evenly into bottom of pan. </div></li></ul></div>
        <div class="wprm-recipe-instruction-group"><h4 class="wprm-recipe-group-name wprm-recipe-instruction-group-name wprm-block-text-bold">Cake</h4><ul class="wprm-recipe-instructions"><li class="wprm-recipe-instruction" style="list-style-type:decimal"><div class="wprm-recipe-instruction-text">Heat oven to 300ºF.  </div></li><li class="wprm-recipe-instruction" style="list-style-type:decimal"><div class="wprm-recipe-instruction-text">Beat cream cheese until fluffy in large bowl. Gradually beat in sweetened condensed milk until smooth. Add eggs, lemon juice, and vanilla; mix well — but not too vigorously. Pour over crust.</div></li><li class="wprm-recipe-instruction" style="list-style-type:decimal"><div class="wprm-recipe-instruction-text">Bake 50 to 55 minutes or until center is set (center springs back when lightly touched). Cool. Chill.</div></li></ul></div>
      </div>
      <div class="wprm-recipe-notes-container wprm-block-text-normal"><h3 class="wprm-recipe-header wprm-recipe-notes-header wprm-block-text-bold">Notes</h3><div class="wprm-recipe-notes"><span style="display:block">A graham cracker crust can be use instead of the almond flour crust described above.</span><div class="wprm-spacer"></div><span style="display:block">If your cheesecake has cracks or bubbles, you may have overmixed your eggs.</span><div class="wprm-spacer"></div><span style="display:block">Resist checking on your cake in the oven until it’s almost done!</span></div></div>
    </div>
  </div>
</BaseLayout>
